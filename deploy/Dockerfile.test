# Test environment with poppler-utils, Pandoc and Typst (no LaTeX).
# Application code is NOT copied in; mount the repo at /app at run time.
# Use scripts/test-docker.sh.
FROM rust:1.95-slim-bookworm

ARG TARGETARCH
ARG TYPST_VERSION=0.12.0
ARG PANDOC_VERSION=3.6.3

RUN apt-get -o Acquire::Retries=5 update && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
    ca-certificates \
    curl \
    xz-utils \
    pkg-config \
    libssl-dev \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# Static Pandoc binary
RUN set -eux; \
    case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
        arm64) PANDOC_ARCH="arm64" ;; \
        *) PANDOC_ARCH="amd64" ;; \
    esac; \
    curl --retry 5 --retry-delay 2 --retry-all-errors --fail --location --silent --show-error "https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-linux-${PANDOC_ARCH}.tar.gz" \
    | tar -xz --strip-components=2 -C /usr/local/bin "pandoc-${PANDOC_VERSION}/bin/pandoc"; \
    chmod +x /usr/local/bin/pandoc

# Static Typst binary
RUN set -eux; \
    case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
        arm64) TYPST_ARCH="aarch64-unknown-linux-musl" ;; \
        *) TYPST_ARCH="x86_64-unknown-linux-musl" ;; \
    esac; \
    curl --retry 5 --retry-delay 2 --retry-all-errors --fail --location --silent --show-error "https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/typst-${TYPST_ARCH}.tar.xz" \
    | tar -xJ --strip-components=1 -C /usr/local/bin "typst-${TYPST_ARCH}/typst"; \
    chmod +x /usr/local/bin/typst

ENV DOC_ENGINE=typst \
    TYPST_BIN=/usr/local/bin/typst \
    PANDOC_BIN=/usr/local/bin/pandoc \
    PDF_MD_REQUIRE_TOOLS=1 \
    HOME=/tmp \
    XDG_DATA_HOME=/tmp \
    XDG_CACHE_HOME=/tmp

WORKDIR /app

CMD ["cargo", "test", "--workspace"]
