# ==========================================
# Stage 1: Frontend Build (Astro + Tailwind v4 + React)
# ==========================================
FROM --platform=$BUILDPLATFORM node:22-alpine AS frontend-builder
WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm install

COPY frontend/ ./
RUN npm run build

# ==========================================
# Stage 2: Rust Server Build
# ==========================================
FROM rust:1.95-slim-bookworm AS backend-builder
WORKDIR /app

RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock* ./
COPY crates/ ./crates/

RUN cargo build --release --bin disposable-server

# ==========================================
# Stage 3: Minimal Lambda Container Runtime
# ==========================================
FROM debian:bookworm-slim AS runtime

ARG TARGETARCH
ARG TYPST_VERSION=0.12.0
ARG PANDOC_VERSION=3.6.3

# Install dependencies for downloading and running typst and pandoc
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Install static Pandoc v3.6.3 binary (natively supports --pdf-engine=typst)
RUN set -eux; \
    if [ "$TARGETARCH" = "arm64" ]; then \
        PANDOC_ARCH="arm64"; \
    else \
        PANDOC_ARCH="amd64"; \
    fi; \
    curl -fsSL "https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-linux-${PANDOC_ARCH}.tar.gz" \
    | tar -xz --strip-components=2 -C /usr/local/bin "pandoc-${PANDOC_VERSION}/bin/pandoc" \
    && chmod +x /usr/local/bin/pandoc

# Install static Typst binary for instant, low-memory PDF compilation
RUN set -eux; \
    if [ "$TARGETARCH" = "arm64" ]; then \
        TYPST_ARCH="aarch64-unknown-linux-musl"; \
    else \
        TYPST_ARCH="x86_64-unknown-linux-musl"; \
    fi; \
    curl -fsSL "https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/typst-${TYPST_ARCH}.tar.xz" \
    | tar -xJ --strip-components=1 -C /usr/local/bin "typst-${TYPST_ARCH}/typst" \
    && chmod +x /usr/local/bin/typst

# Copy AWS Lambda Web Adapter to run unmodified Axum HTTP server on Lambda
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1 /lambda-adapter /opt/extensions/lambda-adapter

WORKDIR /app

# Copy compiled backend binary and frontend assets
COPY --from=backend-builder /app/target/release/disposable-server /usr/local/bin/disposable-server
COPY --from=frontend-builder /app/frontend/dist /app/frontend/dist

# Lambda Web Adapter and Serverless environment variables
ENV PORT=8080
ENV AWS_LWA_PORT=8080
ENV AWS_LWA_READINESS_CHECK_PATH=/api/auth/status
ENV HOST=0.0.0.0
ENV STATIC_DIR=/app/frontend/dist
ENV DOC_ENGINE=typst
ENV TYPST_BIN=/usr/local/bin/typst
ENV PANDOC_BIN=/usr/local/bin/pandoc
ENV HOME=/tmp
ENV XDG_DATA_HOME=/tmp
ENV XDG_CACHE_HOME=/tmp

EXPOSE 8080

CMD ["/usr/local/bin/disposable-server"]
